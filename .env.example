# GEMINI_API_KEY: Required for Gemini AI API calls (URL / text extraction).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional listen port (default 3000). Render sets it automatically.
# PORT=3000

# Supabase (free Postgres + Google sign-in). Required in production: the API refuses to serve without it.
# Create a project at https://supabase.com → Project Settings → API
# SUPABASE_URL = Project URL
# SUPABASE_ANON_KEY = anon / publishable key (public by design; row-level security keeps each user's jobs private)
# Leave both empty for local development: the app then skips sign-in and stores jobs in spreadsheet_data.json.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# GOOGLE_OAUTH_CLIENT_ID: Optional. The Google OAuth client ID you entered in Supabase → Authentication → Google.
# With it, sign-in runs in Google's popup on this site, so Google's account chooser names this app instead of the
# Supabase project. Add this site's URL under the client's Authorized JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=""

# EXTRACTION_DAILY_LIMIT: Gemini extractions each user can run per UTC day (default 30; 0 turns it off). Company-fact
# lookups get the same number, counted separately. Only steps that call Gemini count; past the limit, jobs are still
# saved without Gemini, from ATS data or the deterministic parsers.
EXTRACTION_DAILY_LIMIT=""

# ALLOWED_USER_EMAILS: Optional comma-separated Google account email addresses allowed to call /api.
# Leave empty to let any signed-in Google account use the tracker.
ALLOWED_USER_EMAILS=""

# Gmail status suggestions (optional, owner only). All three must be set or the feature stays off.
# Setup steps: docs/GMAIL_BRIDGE.md.
# GMAIL_BRIDGE_URL = the Apps Script web app's /exec URL
# GMAIL_BRIDGE_KEY = the key printed by the script's setup() function
# GMAIL_BRIDGE_OWNER_EMAIL = the only Google account allowed to see the suggestions
GMAIL_BRIDGE_URL=""
GMAIL_BRIDGE_KEY=""
GMAIL_BRIDGE_OWNER_EMAIL=""
