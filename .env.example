# GEMINI_API_KEY: Required for Gemini AI API calls (URL / text extraction).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional listen port for the local Node server (default 3000). Unused on Cloudflare.
# PORT=3000

# Supabase (free Postgres + Google sign-in). Required in production: the API refuses to serve without it.
# Create a project at https://supabase.com → Project Settings → API
# SUPABASE_URL = Project URL
# SUPABASE_ANON_KEY = anon / publishable key (public by design; row-level security keeps each user's jobs private)
# Leave both empty for local development: the app then skips sign-in and stores jobs in spreadsheet_data.json.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# GOOGLE_OAUTH_CLIENT_ID: Recommended. The Google OAuth client ID you entered in Supabase → Authentication → Google.
# With it, sign-in runs in Google's popup on this site, so Google's account chooser names this app instead of the
# Supabase project. Google Sheets sync also needs it. Add this site's URL under the client's Authorized JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=""

# EXTRACTION_DAILY_LIMIT: Gemini extractions each user gets per UTC day (default 30; 0 turns the limit off), plus the
# same number of company-fact lookups. Only steps that call Gemini count. Once the limit is reached, jobs are still
# saved from ATS data or the deterministic parsers (marked Needs review).
EXTRACTION_DAILY_LIMIT=""

# ALLOWED_USER_EMAILS: Optional comma-separated Google account email addresses allowed to call /api.
# Leave empty to let any signed-in Google account use the tracker.
ALLOWED_USER_EMAILS=""

# Gmail status suggestions (optional, owner only). Setup steps: docs/GMAIL_BRIDGE.md.
# GMAIL_BRIDGE_URL = the Apps Script web app's /exec URL; GMAIL_BRIDGE_KEY = its shared key.
# GMAIL_BRIDGE_OWNER_EMAIL = the only account that sees suggestions. All three must be set or the feature stays off.
GMAIL_BRIDGE_URL=""
GMAIL_BRIDGE_KEY=""
GMAIL_BRIDGE_OWNER_EMAIL=""
