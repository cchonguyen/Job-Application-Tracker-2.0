# GEMINI_API_KEY: Required for Gemini AI API calls (URL / text extraction).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional listen port (default 3000). Render sets it automatically.
# PORT=3000

# Supabase (free Postgres + Google sign-in). Required in production: the API refuses to serve without it.
# Create a project at https://supabase.com → Project Settings → API
# SUPABASE_URL = Project URL
# SUPABASE_ANON_KEY = anon / publishable key (public by design; row-level security keeps each user's jobs private)
# Leave both empty for local development: the app then skips sign-in and stores jobs in spreadsheet_data.json.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# GOOGLE_OAUTH_CLIENT_ID: Optional. The Google OAuth client ID you entered in Supabase → Authentication → Google.
# With it, sign-in runs in Google's popup on this site, so Google's account chooser names this app instead of the
# Supabase project. Add this site's URL under the client's Authorized JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=""

# EXTRACTION_DAILY_LIMIT: Jobs each user can add by link or pasted text per UTC day (default 30; 0 turns it off).
# Every extraction can spend Gemini quota, so this keeps one account from using it all.
EXTRACTION_DAILY_LIMIT=""

# Optional: Gmail status suggestions for one owner account (docs/GMAIL_BRIDGE.md)
GMAIL_BRIDGE_URL=
GMAIL_BRIDGE_KEY=
GMAIL_BRIDGE_OWNER_EMAIL=
