# GEMINI_API_KEY: Required for Gemini AI API calls (URL / text extraction).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public URL of this app (for reference / links).
APP_URL="MY_APP_URL"

# Supabase (free Postgres). Required on Render so jobs survive redeploys.
# Create a project at https://supabase.com → Settings → API
# SUPABASE_URL = Project URL
# SUPABASE_SERVICE_ROLE_KEY = service_role secret (server only — never expose to the browser)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# API_ACCESS_KEY: Protects every /api route. Required when NODE_ENV=production (the API refuses to serve
# without it). Leave empty for local development to keep the API open on your machine.
# Generate one with: openssl rand -hex 32
API_ACCESS_KEY=""
